                                "typeConversionSettings": {
                                    "allowDataTruncation": true,
                                    "treatBooleanAsNumber": false
                                }
                            }
                        },
                        "inputs": [
                            {
                                "referenceName": "sqL_Dataset",
                                "type": "DatasetReference",
                                "parameters": {}
                            }
                        ],
                        "outputs": [
                            {
                                "referenceName": "Parquet_Generic",
                                "type": "DatasetReference",
                                "parameters": {
                                    "Foldername": "ClaimData"
                                }
                            }
                        ]
