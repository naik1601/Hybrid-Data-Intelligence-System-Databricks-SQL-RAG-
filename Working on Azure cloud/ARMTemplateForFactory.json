                    "referenceName": "SqlDbLinkedService",
                    "type": "LinkedServiceReference"
                },
                "annotations": [],
                "type": "AzureSqlTable",
                "schema": [
                    {
                        "name": "branch_id",
                        "type": "int",
                        "precision": 10
                    },
                    {
                        "name": "branch_country",
                        "type": "varchar"
                    },
                    {
                        "name": "branch_city",
                        "type": "varchar"
                    }
                ],
                "typeProperties": {
                    "schema": "dbo",
                    "table": "Branch"
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/SqlDbLinkedService')]"
