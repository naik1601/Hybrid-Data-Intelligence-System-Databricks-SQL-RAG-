{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "policyprojdataadf"
        },
        "SqlDbLinkedService_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'SqlDbLinkedService'"
        },
        "Adls_ls_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'Adls_ls'"
        },
        "AzureDatabricks1_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
        },
        "SqlDbLinkedService_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "policyprojsqlserver.database.windows.net"
        },
        "SqlDbLinkedService_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "policydatabse"
        },
        "SqlDbLinkedService_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "policy"
        },
        "Adls_ls_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://projpolicysytem.dfs.core.windows.net/"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "policyprojdataadf_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "SqlDbLinkedService_password": {
                        "value": "[parameters('SqlDbLinkedService_password')]"
                    },
                    "Adls_ls_accountKey": {
                        "value": "[parameters('Adls_ls_accountKey')]"
                    },
                    "AzureDatabricks1_accessToken": {
                        "value": "[parameters('AzureDatabricks1_accessToken')]"
                    },
                    "SqlDbLinkedService_properties_typeProperties_server": {
                        "value": "[parameters('SqlDbLinkedService_properties_typeProperties_server')]"
                    },
                    "SqlDbLinkedService_properties_typeProperties_database": {
                        "value": "[parameters('SqlDbLinkedService_properties_typeProperties_database')]"
                    },
                    "SqlDbLinkedService_properties_typeProperties_userName": {
                        "value": "[parameters('SqlDbLinkedService_properties_typeProperties_userName')]"
                    },
                    "Adls_ls_properties_typeProperties_url": {
                        "value": "[parameters('Adls_ls_properties_typeProperties_url')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}